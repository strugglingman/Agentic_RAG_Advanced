# ==============================================================================
# Docker Compose Environment Variables
# ==============================================================================
# This file contains secrets for Docker deployment.
# Copy to .env.docker and fill in real values for production.
# NEVER commit real secrets to git!

# ==============================================================================
# PostgreSQL Database
# ==============================================================================
POSTGRES_USER=db_user
POSTGRES_PASSWORD=db_password
POSTGRES_DB=db_name

# ==============================================================================
# Authentication Secrets
# ==============================================================================
# Generate with: openssl rand -base64 32
APP_BASE_URL=http://your-ec2-public-ip
NEXTAUTH_SECRET=this is a test next auth secret please change
SERVICE_AUTH_SECRET=this is a test service auth secret please change
SERVICE_AUTH_ISSUER=service_name
SERVICE_AUTH_AUDIENCE=service_audience
NEXT_PUBLIC_UPLOAD_FILE_LIMIT_MB=25
S3_BACKUP_BUCKET=your-backup-bucket-name
S3_BACKUP_PREFIX=postgres
LOCAL_POSTGRES_BACKUP_KEEP_COUNT=5

# ==============================================================================
# Observability
# ==============================================================================
OTEL_ENABLED=true
OTEL_SERVICE_NAME=agentic-rag-backend
OTEL_SERVICE_NAMESPACE=agentic-rag
OTEL_SERVICE_VERSION=1.0.0
OTEL_DEPLOYMENT_ENVIRONMENT=aws-dev
