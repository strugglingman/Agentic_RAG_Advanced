# ---- Node / Next.js ----
node_modules/
.next/
out/
dist/
build/
# Next auth session + generated stuff (if any)
.vercel/

# ---- Python ----
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg-info/
.venv/
venv/
.mypy_cache/
.pytest_cache/

# ---- Environment / Secrets ----
# Ignore real env files but allow committed example templates
.env*
!.env.example
!.env.docker.example
*.env.local
.env.local
.env.development.local
.env.production.local

# ---- Databases / Vector stores ----
qdrant_data/
backend/data/
backend/uploads/
*.sqlite3

# If you want to keep uploads/chroma structure, add placeholder .keep files and remove from ignore.

# ---- Logs / Reports (optional ignore) ----
*.log
report/*.json
coverage/
.coverage
coverage.xml
reports/playwright/
playwright-report/
test-results/
frontend/reports/
frontend/tsconfig.tsbuildinfo
nul
frontend/.npm-cache/
pytest-cache-files-*/
backend/pytest-cache-files-*/

# ---- OS / Editor ----
.DS_Store
Thumbs.db
.vscode/
.idea/

# ---- Docker artifacts ----
**/*~

# ---- Nginx / SSL ----
nginx/ssl/*.pem
nginx/ssl/*.key
nginx/ssl/*.crt
nginx/logs/

# ---- Misc ----
*.tmp
*.swp
materials/*

# ---- Reports / Generated files (optional) ----
reports/*.md
!reports/README.md

# Uncomment if you generate large model files locally
# models/

# Keep README or schema files even in ignored folders by adding ! exceptions if needed.
