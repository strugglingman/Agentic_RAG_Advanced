# ==============================================================================
# Frontend local environment template
# ==============================================================================

# Prisma / NextAuth database connection
DATABASE_URL=postgresql://user:password@localhost:5432/chatbot?schema=chatbot

# Backend API base URL used by Next.js route handlers
FASTAPI_URL=http://localhost:5001

# NextAuth configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret
AUTH_TRUST_HOST=true

# Service-to-service authentication
SERVICE_AUTH_SECRET=replace-with-the-same-secret-as-backend
SERVICE_AUTH_ISSUER=chat-frontend
SERVICE_AUTH_AUDIENCE=fastapi-backend

# Frontend build-time public configuration
NEXT_PUBLIC_UPLOAD_FILE_LIMIT_MB=25

# Server-side route timeout for ingestion proxying
INGEST_TIMEOUT_MS=600000
