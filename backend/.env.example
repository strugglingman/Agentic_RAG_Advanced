# ==============================================================================
# Python logging configuration
# ==============================================================================
LOG_LEVEL=DEBUG
LOG_FORMAT=%(asctime)s trace_id=%(trace_id)s span_id=%(span_id)s correlation_id=%(correlation_id)s %(funcName)s:%(lineno)d %(message)s
LOG_PATH=logs/app.log

# ==============================================================================
# Application Settings
# ==============================================================================
ENV=development
DEBUG=true
TESTING=false
CORS_ORIGINS=http://localhost:3000

# ==============================================================================
# OpenAI API Configuration
# ==============================================================================
OPENAI_MODEL=gpt-4o-mini
OPENAI_SIMPLE_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.1
OPENAI_API_KEY=sk-your-openai-api-key-here

# Agent execution and resilience
LLM_MAX_RETRIES=3
LLM_TIMEOUT=40
LLM_CONNECT_TIMEOUT=10
LLM_CB_FAILURE_THRESHOLD=5
LLM_CB_RECOVERY_TIMEOUT=30
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
AGENT_MAX_ITERATIONS=20
AGENT_TIMEOUT=300
AGENT_TOOL_TIMEOUT=60

# ==============================================================================
# LangSmith Tracing
# ==============================================================================
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your-langchain-api-key-here
LANGCHAIN_PROJECT=agentic-rag-chatbot
LANGCHAIN_ENDPOINT=https://eu.api.smith.langchain.com

# ==============================================================================
# OpenTelemetry
# ==============================================================================
OTEL_ENABLED=false
OTEL_SERVICE_NAME=agentic-rag-backend
OTEL_SERVICE_NAMESPACE=agentic-rag
OTEL_SERVICE_VERSION=1.0.0
OTEL_DEPLOYMENT_ENVIRONMENT=development
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_TRACES_SAMPLER_ARG=1.0

# ==============================================================================
# LangGraph Configuration
# ==============================================================================
USE_LANGGRAPH=true
USE_SEMANTIC_ROUTER=false
CHECKPOINT_ENABLED=false

# ==============================================================================
# Embedding & Reranking Models
# ==============================================================================
EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-base
RERANKER_PROVIDER=local
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
COHERE_API_KEY=your-cohere-api-key-here
COHERE_RERANK_MODEL=rerank-v3.5

# ==============================================================================
# Local data and vector database
# ==============================================================================
DATA_DIR=./data
VECTOR_DB_PROVIDER=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=documents
QDRANT_PREFER_GRPC=true
QDRANT_SPARSE_MODEL=Qdrant/bm25

# ==============================================================================
# PostgreSQL Database (Conversations & Checkpoints)
# ==============================================================================
DATABASE_URL=postgresql://user:password@localhost:5432/chatbot?schema=chatbot
CHECKPOINT_POSTGRES_DATABASE_URL=postgresql://user:password@localhost:5432/chatbot
CONVERSATION_MESSAGE_LIMIT=200
CONVERSATION_USER_LIMIT=50

# ==============================================================================
# Redis Cache
# ==============================================================================
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379
REDIS_CACHE_TTL=3600
REDIS_CACHE_LIMIT=15
AGENT_STATE_TTL=3600

# ==============================================================================
# Retrieval & Search Settings
# ==============================================================================
USE_HYBRID=true
USE_RERANKER=true
TOP_K=8
CANDIDATES=50
FORCE_INTERNAL_RETRIEVAL=false
FUSION_METHOD=rrf
RRF_K=60
FUSE_ALPHA=0.5
MIN_HYBRID=0.50
AVG_HYBRID=0.45
MIN_SEM_SIM=0.35
AVG_SEM_SIM=0.25
MIN_RERANK=0.30
AVG_RERANK=0.15
RERANKER_THRESHOLD_RELAXATION=0.75
MIN_RAW_BM25=2.0
ENFORCE_CITATIONS=true

# ==============================================================================
# Retrieval decomposition
# ==============================================================================
DECOMPOSITION_ENABLED=false
DECOMPOSITION_MAX_WORKERS=8

# ==============================================================================
# Document Processing & Chunking
# ==============================================================================
CHUNK_SIZE=400
CHUNK_OVERLAP=80
CHUNKING_STRATEGY=recursive
TIKTOKEN_ENCODING=cl100k_base
CONTEXTUAL_RETRIEVAL_ENABLED=true
CONTEXTUAL_RETRIEVAL_MODEL=gpt-4o-mini
CONTEXTUAL_RETRIEVAL_MAX_WORKERS=8
TEXT_MAX=-1
UPSERT_BATCH_SIZE=500

# ==============================================================================
# Chat Settings
# ==============================================================================
CHAT_MAX_TOKENS=16000
ONE_HISTORY_MAX_TOKENS=1500
PLANNING_CONTEXT_LIMIT=10
MAX_HISTORY=6

# ==============================================================================
# File Upload Configuration
# ==============================================================================
UPLOAD_BASE=uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25
ALLOWED_EXTENSIONS=txt,pdf,docx,md
MIME_TYPES=text/plain,text/markdown,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument
FOLDER_SHARED=shared
DEPT_SPLIT=|
FILE_LIST_LIMIT_IN_UPLOAD_PAGE=500

# ==============================================================================
# Authentication & Authorization
# ==============================================================================
SERVICE_AUTH_SECRET=your-service-auth-secret-here
SERVICE_AUTH_ISSUER=your_service_name
SERVICE_AUTH_AUDIENCE=your_service_audience

# ==============================================================================
# Organization Structure
# ==============================================================================
ORG_STRUCTURE_FILE=org_structure.json

# ==============================================================================
# Rate Limiting
# ==============================================================================
RATELIMIT_STORAGE_URI=memory://
DEFAULT_RATE_LIMITS=500 per day,20 per minute

# ==============================================================================
# MCP / Brave Search
# ==============================================================================
MCP_TRIGGER_THRESHOLD=0.6
MCP_SERVER_COMMAND=npx -y @modelcontextprotocol/server-brave-search
BRAVE_API_KEY=your-brave-api-key-here

# ==============================================================================
# E2B Code Execution
# ==============================================================================
E2B_API_KEY=
CODE_EXECUTION_ENABLED=true

# ==============================================================================
# Web Search Configuration
# ==============================================================================
WEB_SEARCH_ENABLED=false
WEB_SEARCH_PROVIDER=duckduckgo
WEB_SEARCH_MAX_RESULTS=5
TAVILY_API_KEY=your-tavily-api-key-here

# ==============================================================================
# Debug & Logging
# ==============================================================================
SHOW_SCORES=false

# ==============================================================================
# Self-Reflection / Retrieval Evaluation
# ==============================================================================
USE_SELF_REFLECTION=true
REFLECTION_MODE=balanced
REFLECTION_THRESHOLD_EXCELLENT=0.85
REFLECTION_THRESHOLD_GOOD=0.70
REFLECTION_THRESHOLD_PARTIAL=0.50
REFLECTION_MIN_CONTEXTS=1
REFLECTION_AVG_SCORE=0.6
REFLECTION_KEYWORD_OVERLAP=0.3
REFLECTION_AUTO_REFINE=true
REFLECTION_AUTO_EXTERNAL=false
REFLECTION_MAX_REFINEMENT_ATTEMPTS=3

# ==============================================================================
# Query Routing
# ==============================================================================
COMPLEXITY_THRESHOLD=0.6
ENABLE_QUERY_ROUTING=true

# ==============================================================================
# File Discovery
# ==============================================================================
FILE_DISCOVERY_INDEXED_LIMIT=200
FILE_DISCOVERY_CONVERSATION_LIMIT=20

# ==============================================================================
# SMTP Email Configuration
# ==============================================================================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here

# ==============================================================================
# Download Settings
# ==============================================================================
DOWNLOAD_BASE=downloads
MAX_DOWNLOAD_SIZE_MB=100
DOWNLOAD_TIMEOUT=30

# ==============================================================================
# Browser Automation (Browser-Use)
# ==============================================================================
BROWSER_USE_ENABLED=false
BROWSER_HEADLESS=true
BROWSER_TIMEOUT=60
BROWSER_MAX_STEPS=15
BROWSER_TEST_USERNAME=
BROWSER_TEST_PASSWORD=
BROWSER_LOG_PATH=logs/browser_agent.log

# ==============================================================================
# Bot / Adapter Configuration
# ==============================================================================
BACKEND_API_TIMEOUT=330
BOT_BACKEND_URL=http://localhost:5001

# ==============================================================================
# Slack Configuration
# ==============================================================================
SLACK_ENABLED=false
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token-here
SLACK_SIGNING_SECRET=your-slack-signing-secret-here
SLACK_DEFAULT_DEPT=MYHB|software|ml
SLACK_HISTORY_LIMIT=30
